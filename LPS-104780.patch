+			String productId = entry.getKey();
+
+			AtomicStampedReference<License> licenseStampedReference =
+				entry.getValue();
+
+			int[] stampHolder = new int[1];
+
+			License license = licenseStampedReference.get(stampHolder);
+
+			int licenseState = stampHolder[0];
