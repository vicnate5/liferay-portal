+package com.liferay.portal.ee.license.messaging;
+
+import com.liferay.portal.ee.license.LCSLicenseManager;
+import com.liferay.portal.kernel.json.JSONObject;
+import com.liferay.portal.kernel.license.messaging.LCSPortletState;
+import com.liferay.portal.kernel.license.messaging.LicenseManagerMessageType;
+import com.liferay.portal.kernel.log.Log;
+import com.liferay.portal.kernel.log.LogFactoryUtil;
+import com.liferay.portal.kernel.messaging.BaseMessageListener;
+import com.liferay.portal.kernel.messaging.Message;
+
+/**
+ * @author Amos Fong
+ * @author Igor Beslic
+ */
+public class LicenseMessageListener extends BaseMessageListener {
+
+	@Override
+	protected void doReceive(Message message) throws Exception {
+		if (_log.isDebugEnabled()) {
+			_log.debug("Received message: " + message.toString());
+		}
+
+		JSONObject jsonObject = LCSLicenseManager.getMessagePayload(message);
+
+		if (jsonObject == null) {
+			if (_log.isDebugEnabled()) {
+				_log.debug("Message discarded");
+			}
+
+			return;
+		}
+
+		LCSPortletState lcsPortletState = LCSPortletState.valueOf(
+			jsonObject.getInt("state"));
+
+		LicenseManagerMessageType licenseManagerMessageType =
+			LicenseManagerMessageType.valueOf(jsonObject);
+
+		if ((licenseManagerMessageType !=
+				LicenseManagerMessageType.LCS_AVAILABLE) &&
+			(licenseManagerMessageType !=
+				LicenseManagerMessageType.SUBSCRIPTION_VALID)) {
+
+			if (_log.isDebugEnabled()) {
+				_log.debug(
+					"Unable to process message type " +
+						licenseManagerMessageType.name());
+			}
+
+			return;
+		}
+
+		LCSLicenseManager.setLCSPortletState(lcsPortletState);
+
+		if ((licenseManagerMessageType ==
+				LicenseManagerMessageType.LCS_AVAILABLE) &&
+			(lcsPortletState == LCSPortletState.NO_SUBSCRIPTION)) {
+
+			LCSLicenseManager.checkSubscriptionState();
+		}
+	}
+
+	private static Log _log = LogFactoryUtil.getLog(
+		LicenseMessageListener.class);
+
+}
