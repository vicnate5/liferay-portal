+package com.liferay.portal.app.license.impl.events;
+
+import com.liferay.portal.kernel.events.Action;
+import com.liferay.portal.kernel.events.ActionException;
+import com.liferay.portal.kernel.log.Log;
+import com.liferay.portal.kernel.log.LogFactoryUtil;
+import com.liferay.portal.kernel.model.Group;
+import com.liferay.portal.kernel.theme.ThemeDisplay;
+import com.liferay.portal.kernel.util.StringBundler;
+import com.liferay.portal.kernel.util.StringPool;
+import com.liferay.portal.kernel.util.Validator;
+import com.liferay.portal.kernel.util.WebKeys;
+
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentMap;
+
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+
+/**
+ * @author Amos Fong
+ */
+public class MarketplaceAppServicePreAction extends Action {
+
+	public MarketplaceAppServicePreAction(
+		String bundleSymbolicName, String licensePageURL) {
+
+		_developerBundleNames.put(bundleSymbolicName, bundleSymbolicName);
+		_licensePageURL = licensePageURL;
+	}
+
+	public void addDeveloperBundle(String bundleSymbolicName) {
+		_developerBundleNames.putIfAbsent(
+			bundleSymbolicName, bundleSymbolicName);
+	}
+
+	public void removeDeveloperBundle(String bundleSymbolicName) {
+		_developerBundleNames.remove(bundleSymbolicName);
+	}
+
+	@Override
+	public void run(HttpServletRequest request, HttpServletResponse response)
+		throws ActionException {
+
+		try {
+			_clientIPAddresses.putIfAbsent(
+				request.getRemoteAddr(), request.getRemoteAddr());
+
+			if (_clientIPAddresses.size() > 10) {
+				if (_isControlPanel(request)) {
+					response.sendRedirect(_licensePageURL);
+
+					return;
+				}
+				else if (_isLicensePage(request)) {
+					StringBundler sb = new StringBundler(4);
+
+					sb.append("You have exceeded the developer license ");
+					sb.append("connection limit for ");
+					sb.append(_getBundleSymbolicName());
+					sb.append(".");
+
+					request.setAttribute("ERROR_MESSAGE", sb.toString());
+				}
+			}
+		}
+		catch (Exception e) {
+			if (_log.isDebugEnabled()) {
+				_log.debug(e, e);
+			}
+		}
+	}
+
+	private String _getBundleSymbolicName() {
+		for (String key : _developerBundleNames.keySet()) {
+			return key;
+		}
+
+		return null;
+	}
+
+	private boolean _isControlPanel(HttpServletRequest request) {
+		ThemeDisplay themeDisplay = (ThemeDisplay)request.getAttribute(
+			WebKeys.THEME_DISPLAY);
+
+		if (themeDisplay != null) {
+			Group group = themeDisplay.getScopeGroup();
+
+			if (group.isControlPanel()) {
+				return true;
+			}
+		}
+
+		return false;
+	}
+
+	private boolean _isLicensePage(HttpServletRequest request) {
+		String pathInfo = request.getPathInfo();
+
+		if (Validator.isNull(pathInfo) ||
+			!pathInfo.startsWith(StringPool.SLASH)) {
+
+			return false;
+		}
+
+		if (pathInfo.equals("/portal/license")) {
+			return true;
+		}
+		else {
+			return false;
+		}
+	}
+
+	private static final Log _log = LogFactoryUtil.getLog(
+		MarketplaceAppServicePreAction.class);
+
+	private final ConcurrentMap<String, String> _clientIPAddresses =
+		new ConcurrentHashMap<>();
+	private final ConcurrentMap<String, String> _developerBundleNames =
+		new ConcurrentHashMap<>();
+	private final String _licensePageURL;
+
+}
