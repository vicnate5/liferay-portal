@default = "selectFrame"
definition {

	function selectFrame {
		if (contains("${locator1}", "/iframe")) {
			selenium.waitForVisible();

			selenium.mouseOver();

			if (contains("${locator1}", "dialog-iframe-node")) {
				selenium.waitForElementPresent(
					"${locator1}/../div[contains(@class,'overlaymask-hidden')]"
				);
			}
			else {
				selenium.waitForElementPresent(
					"${locator1}/../iframe[not(contains(@class,'hide'))]"
				);
			}

			selenium.waitForElementNotPresent(//*[(contains(@class,'loading-animation'))]);

			selenium.selectFrame();

			selenium.waitForElementPresent("//body");

			selenium.assertJavaScriptErrors();

			selenium.assertLiferayErrors();
		}
		else {
			SelectFrame.selectFrameTop();
		}

		WaitForSPARefresh();
	}

	function selectFrameNoLoading {
		if (contains("${locator1}", "/iframe")) {
			selenium.waitForVisible();

			selenium.mouseOver();

			selenium.selectFrame();

			selenium.assertJavaScriptErrors();

			selenium.assertLiferayErrors();
		}
		else {
			SelectFrame.selectFrameTop();
		}

		WaitForSPARefresh();
	}

	function selectFrameTop {
		selenium.selectFrame("relative=top");

		selenium.assertJavaScriptErrors();

		selenium.assertLiferayErrors();

		WaitForSPARefresh();
	}

	function selectSecondFrame {
		if (contains("${locator1}", "/iframe")) {
			selenium.waitForVisible();

			selenium.mouseOver();

			if (contains("${locator1}", "dialog-iframe-node")) {
				selenium.waitForElementPresent(
					"xpath=(//div[contains(@class,'overlaymask-hidden')])[2]"
				);
			}
			else {
				selenium.waitForElementPresent(
					"xpath=(//iframe[not(contains(@class,'hide'))])[2]"
				);
			}

			selenium.waitForElementNotPresent(//*[(contains(@class,'loading-animation'))]);

			selenium.selectFrame();

			selenium.waitForElementPresent("//body");

			selenium.assertJavaScriptErrors();

			selenium.assertLiferayErrors();
		}
		else {
			SelectFrame.selectFrameTop();
		}

		WaitForSPARefresh();
	}

}