@component-name = "portal-util-misc"
definition {

	property ci.retries.disabled = "true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Ext";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@priority = 4
	test CanOverridePortalImpl {
		property custom.properties = "spring.bean.com.liferay.portal.language.LanguageResources=com.liferay.ext.test.internal.portal.language.ExtLanguageResources${line.separator}spring.bean.com.liferay.portal.util.Portal=com.liferay.ext.test.internal.portal.util.ExtPortalImpl${line.separator}web.server.display.node=true";
		property osgi.modules.includes = "ext-test-impl";
		property test.liferay.virtual.instance = "false";
		property test.run.type = "single";

		AssertConsoleTextNotPresent(value1 = "No bean named");

		AssertConsoleTextPresent(value1 = "Set portalResourceBundleLoader by ExtLanguageResources");

		Page.assertNodePortPG(nodePort = "ext_portal_impl_installed_");
	}

}