@component-name = "portal-analytics-cloud"
definition {

	property analytics.cloud.release = "true";
	property analytics.cloud.upstream = "true";
	property portal.release = "false";
	property portal.upstream = "true";
	property property.group = "analytics.cloud.profile";
	property testray.main.component.name = "Analytics Cloud";

	var ip1 = MathUtil.randomNumber(255);
	var ip2 = MathUtil.randomNumber(255);
	var ip3 = MathUtil.randomNumber(255);

	static var loopbackAddress = "http://127.${ip1}.${ip2}.${ip3}:8080";

	setUp {
		ACUtils.launchAC();

		ACSettings.takeTokenFromAnalyticsCloud();

		TestCase.setUpPortalInstance();

		ACUtils.launchDXP();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		ACUtils.tearDownAC();

		ACUtils.tearDownDXP();

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Feature ID: Legacy | Automation ID: LRAC-8534 | Test Summary: Sign out of AC"
	@priority = "5"
	test CanSignOutAC {
		task ("Navigate to AC workspace") {
			ACUtils.launchAC();
		}

		task ("Sign out AC") {
			ACWorkspace.signOut();
		}

		task ("View redirect to the Sign In page") {
			AssertVisible(locator1 = "ACLogin#EMAIL_LOGIN_FIELD");

			AssertVisible(locator1 = "ACLogin#PASSWORD_LOGIN_FIELD");

			AssertVisible(locator1 = "ACLogin#LOGIN_BUTTON");
		}
	}

}