@component-name = "marketplace"
definition {

	property marketplace.app.acceptance = "true";
	property testray.main.component.name = "Marketplace";

	var ip1 = MathUtil.randomNumber(255);
	var ip2 = MathUtil.randomNumber(255);
	var ip3 = MathUtil.randomNumber(255);

	static var loopbackAddress = "http://127.${ip1}.${ip2}.${ip3}:8080";

	setUp {
		User.firstLoginPG();
	}

	tearDown {
		BlogsEntry.tearDownCP();
	}

	@priority = "5"
	test MarketplaceSmoke {
		Marketplace.smoke();
	}

}