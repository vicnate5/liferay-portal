{
	"compilerOptions": {
		"esModuleInterop": true,
		"jsx": "react",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2020"
		],
		"module": "ES2020",
		"moduleResolution": "node",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2020",
		"types": [
			"node"
		]
	},
	"include": [
		"scripts/**/*.ts",
		"src/**/*.ts",
		"src/**/*.tsx"
	]
}
